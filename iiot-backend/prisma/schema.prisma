generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Machine {
  id                   Int                   @id @default(autoincrement())
  machineId            String                @unique
  name                 String
  baseRegister         Int                   @unique
  status               Int                   @default(0)
  lastCounter          Int                   @default(0)
  lastTemp             Float                 @default(0.0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  downtimes            Downtime[]
  logs                 MachineLog[]
  maintenanceSchedules MaintenanceSchedule[]
  plannedDts           PlannedDowntime[]
}

model Downtime {
  id           Int       @id @default(autoincrement())
  machineId    Int
  startTime    DateTime  @default(now())
  endTime      DateTime?
  duration     Int?
  isPlanned    Boolean   @default(false)
  operatorNote String?
  isApproved   Boolean   @default(false)
  approvedBy   String?
  createdAt    DateTime  @default(now())
  reason       String?
  machine      Machine   @relation(fields: [machineId], references: [id])
}

model AlarmConfig {
  id          Int    @id @default(autoincrement())
  alarmCode   Int    @unique
  description String
  severity    String @default("CRITICAL")
}

model PlannedDowntime {
  id          Int      @id @default(autoincrement())
  machineId   Int
  planDate    DateTime
  duration    Int
  reason      String
  isLocked    Boolean  @default(true)
  submittedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  machine     Machine  @relation(fields: [machineId], references: [id])
}

model MachineLog {
  id           Int      @id @default(autoincrement())
  machineId    Int
  counterValue Int
  temperature  Float
  status       Int
  createdAt    DateTime @default(now())
  machine      Machine  @relation(fields: [machineId], references: [id])
}

model MaintenanceSchedule {
  id          Int      @id @default(autoincrement())
  machineId   Int
  description String
  scheduledAt DateTime
  status      String   @default("PENDING")
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())
  machine     Machine  @relation(fields: [machineId], references: [id])
}

model USERS {
  id        Int             @id(map: "PK_b16c39a00c89083529c6166fa5b") @default(autoincrement())
  username  String          @unique(map: "UQ_055984372b62f71f274f3fe361a") @db.VarChar
  password  String          @db.VarChar
  role      USERS_role_enum @default(OPERATOR)
  createdAt DateTime        @default(now()) @db.Timestamp(6)
}

model breakdown_events {
  id            Int      @id(map: "PK_a63fb9c07207480457c3d617292") @default(autoincrement())
  machineId     String   @db.VarChar
  machineName   String   @default("Unknown Machine") @db.VarChar
  ErrorMessages String   @default("No error message provided ") @db.VarChar
  duration      Int
  createdAt     DateTime @default(now()) @db.Timestamp(6)
}

enum USERS_role_enum {
  OPERATOR
  SUPERVISOR
  MANAGER
  PPIC
}
